<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>PettableVikings</AssemblyName>
    <Version>1.0.2</Version>
    <!-- Default Steam path on Linux; override with -p:ValheimPath=... -->
    <ValheimPath Condition="'$(ValheimPath)' == ''">$(HOME)/.local/share/Steam/steamapps/common/Valheim</ValheimPath>
    <!-- Mod manager profile folder (Gale: Settings > Browse Profile Folder); must contain BepInEx/core -->
    <BepInExProfilePath Condition="'$(BepInExProfilePath)' == ''"></BepInExProfilePath>
  </PropertyGroup>

  <!-- Never copy game or BepInEx DLLs into the build output -->
  <ItemDefinitionGroup>
    <Reference>
      <Private>false</Private>
    </Reference>
  </ItemDefinitionGroup>

  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExProfilePath)/BepInEx/core/BepInEx.dll</HintPath>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExProfilePath)/BepInEx/core/0Harmony.dll</HintPath>
    </Reference>
    <Reference Include="assembly_valheim">
      <HintPath>$(ValheimPath)/valheim_Data/Managed/assembly_valheim.dll</HintPath>
    </Reference>
    <Reference Include="assembly_guiutils">
      <HintPath>$(ValheimPath)/valheim_Data/Managed/assembly_guiutils.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(ValheimPath)/valheim_Data/Managed/UnityEngine.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ValheimPath)/valheim_Data/Managed/UnityEngine.CoreModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(ValheimPath)/valheim_Data/Managed/UnityEngine.PhysicsModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.AnimationModule">
      <HintPath>$(ValheimPath)/valheim_Data/Managed/UnityEngine.AnimationModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.AudioModule">
      <HintPath>$(ValheimPath)/valheim_Data/Managed/UnityEngine.AudioModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.ParticleSystemModule">
      <HintPath>$(ValheimPath)/valheim_Data/Managed/UnityEngine.ParticleSystemModule.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>